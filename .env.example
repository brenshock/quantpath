# Keep this secret on the server. Never expose it through a NEXT_PUBLIC_ variable.
OPENAI_API_KEY=

# Optional emergency kill switch. Set to false to disable model calls immediately.
TUTOR_ENABLED=true

# Random secret used when hashing visitor IPs for best-effort abuse prevention.
TUTOR_RATE_LIMIT_SALT=

# Public production origin used for canonical links, robots.txt, and the sitemap.
SITE_URL=http://localhost:3000
